---
interface Props {
	class?: string;
}

interface Experience {
	period: string;
	title: string;
	place: string;
}

const { class: className } = Astro.props;

const entries: Experience[] = [
	{
		period: '2025 — Present',
		title: 'Placeholder current role',
		place: 'Company name',
	},
	{
		period: '2023 — 2025',
		title: 'Placeholder previous role',
		place: 'Company name',
	},
	{
		period: '2021 — 2023',
		title: 'Placeholder first role',
		place: 'Company name',
	},
];
---

<section
	id="experience"
	class:list={[
		'w-full min-w-0 font-be-vietnam',
		className,
	]}
>
	<ol class="w-full">
		{
			entries.map((entry, index) => (
				<li class="w-full">
					<article class="group relative z-10 min-w-0 w-full transition-[filter] hover:drop-shadow-[0_0_12px_var(--color-hover)]">
						<div class="cyber-cut bg-border p-1 transition-colors group-hover:bg-hover">
							<div class="cyber-ticks px-5 pt-5 pb-4 sm:px-6 sm:pt-6 sm:pb-5">
								<p class="mb-2 text-[0.65rem] font-semibold tracking-[0.22em] text-border uppercase transition-colors group-hover:text-hover">
									{entry.period}
								</p>
								<h3 class="mb-2 flex items-center gap-2 border-b border-border pb-2 text-[0.7rem] font-semibold tracking-[0.1em] text-hover uppercase">
									<span
										class="size-[0.45rem] shrink-0 bg-hover shadow-[0_0_8px_var(--color-hover)] [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)]"
										aria-hidden="true"
									></span>
									{entry.title}
								</h3>
								<p class="text-xs font-semibold text-border transition-colors group-hover:text-hover sm:text-sm">
									{entry.place}
								</p>
							</div>
						</div>
					</article>
					{
						index < entries.length - 1 && (
							<div
								class="mx-auto h-12 w-px bg-border sm:h-14"
								aria-hidden="true"
							></div>
						)
					}
				</li>
			))
		}
	</ol>
</section>
