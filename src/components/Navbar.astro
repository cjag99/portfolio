---
import ImageSkeleton from './ImageSkeleton.astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const links = [
	{ href: '#skills', label: 'Skills', accent: false },
	{ href: '#projects', label: 'Projects', accent: true },
	{ href: '#contact', label: 'Contact me', accent: false },
] as const;
---

<header
	class:list={[
		'relative z-50 w-full bg-[#fcfcfc] font-be-vietnam shadow-[0_1px_1px_rgba(0,0,0,0.14),0_2px_1px_rgba(0,0,0,0.12),0_1px_3px_rgba(0,0,0,0.2)]',
		className,
	]}
>
	<div class="flex items-center justify-between px-25 py-6">
		<a href="/" class="shrink-0" aria-label="John Doe">
			<ImageSkeleton label="Logo image" class="h-[35px] w-[90px]" />
		</a>

		<nav class="flex w-87.5 items-center justify-between" aria-label="Primary">
			{
				links.map((link) =>
					link.accent ? (
						<a
							href={link.href}
							class="flex items-center justify-center gap-2 text-[18px] leading-normal whitespace-nowrap text-[#e84949]"
						>
							<ImageSkeleton label="Gears icon" compact class="h-[22px] w-6 shrink-0" />
							{link.label}
						</a>
					) : (
						<a href={link.href} class="text-[18px] leading-normal whitespace-nowrap text-black">
							{link.label}
						</a>
					),
				)
			}
		</nav>
	</div>
</header>
