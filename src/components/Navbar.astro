<nav class="flex items-center justify-between flex-wrap bg-gray-900 p-6">
    <div class="flex items-center shrink-0 text-white mr-6">
        <a href="/" class="font-semibold text-xl tracking-tight">Astro Basics</a>
    </div>
    <div class="block lg:hidden">
        <button class="flex items-center px-3 py-2 border rounded text-teal-200 border-teal-400 hover:text-white hover:border-white" data-theme-toggle>
            <svg class="fill-current h-3 w-3" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><title>Menu</title><path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"/></svg>
        </button>    
    </div>
    <div class="w-full block grow lg:flex lg:items-center lg:w-auto">
        <div class="text-sm lg:grow">
            <a href="/about" class="block mt-4 lg:inline-block lg:mt-0 text-teal-200 hover:text-white mr-4">
                About
            </a>
            <a href="/contact" class="block mt-4 lg:inline-block lg:mt-0 text-teal-200 hover:text-white">
                Contact
            </a>
        </div>
        <div>
            <button class="inline-block text-sm px-4 py-2 leading-none border rounded text-white border-white hover:border-transparent hover:text-teal-500 hover:bg-white mt-4 lg:mt-0" data-theme-toggle>
                Dark Mode
            </button>
        </div>
    </div>
</nav>

<script>
  const initThemeToggle = () => {
    const buttons = document.querySelectorAll('[data-theme-toggle]');

    const isDarkMode = () => {
      const storedTheme = window.localStorage.getItem('theme');
      if (storedTheme) {
        return storedTheme === 'dark';
      }
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    };

    /** @param {boolean} dark */
    const applyTheme = (dark: boolean) => {
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      window.localStorage.setItem('theme', dark ? 'dark' : 'light');

      buttons.forEach((button) => {
        button.textContent = dark ? 'Light Mode' : 'Dark Mode';
      });
    };

    const toggleDarkMode = () => {
      applyTheme(!isDarkMode());
    };

    applyTheme(isDarkMode());
    buttons.forEach((button) => {
      button.addEventListener('click', toggleDarkMode);
    });
  };

  document.addEventListener('astro:page-load', initThemeToggle);
  initThemeToggle();
</script>