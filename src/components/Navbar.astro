---
import { Image } from 'astro:assets';
import logo from '../assets/john-doe-logo.png';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const links = [
	{ href: '#skills', label: 'Skills', accent: false },
	{ href: '#projects', label: 'Projects', accent: true },
	{ href: '#contact', label: 'Contact me', accent: false },
] as const;
---

<header
	class:list={[
		'relative z-50 w-full bg-[#fcfcfc] font-be-vietnam shadow-[0_1px_1px_rgba(0,0,0,0.14),0_2px_1px_rgba(0,0,0,0.12),0_1px_3px_rgba(0,0,0,0.2)]',
		className,
	]}
>
	<div class="flex h-[72px] items-center px-8 lg:h-auto lg:justify-between lg:px-[100px] lg:py-6">
		<button
			type="button"
			class="flex flex-col items-start py-[6px] lg:hidden"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Open menu"
		>
			<img src="/images/menu.svg" alt="" width="31.9999" height="23.3123" />
		</button>

		<a href="/" class="hidden shrink-0 lg:block" aria-label="John Doe">
			<Image src={logo} alt="John Doe — here for you" width={90} height={35} />
		</a>

		<nav class="hidden w-[350px] items-center justify-between lg:flex" aria-label="Primary">
			{
				links.map((link) =>
					link.accent ? (
						<a
							href={link.href}
							class="flex items-center justify-center gap-2 text-[18px] leading-normal whitespace-nowrap text-[#e84949]"
						>
							<span class="relative h-[21.818px] w-6 shrink-0 overflow-hidden">
								<span class="absolute top-[4.28%] right-[35.34%] bottom-[31.07%] left-0">
									<img src="/images/gear-big.svg" alt="" width="15.5175" height="14.107" />
								</span>
								<span class="absolute top-[48.68%] right-0 bottom-[4.28%] left-[52.96%]">
									<img src="/images/gear-small.svg" alt="" width="11.2893" height="10.2631" />
								</span>
							</span>
							{link.label}
						</a>
					) : (
						<a
							href={link.href}
							class="text-[18px] leading-normal whitespace-nowrap text-black"
						>
							{link.label}
						</a>
					),
				)
			}
		</nav>
	</div>

	<nav
		id="mobile-nav"
		class="hidden border-t border-black/5 bg-[#fcfcfc] px-8 py-6 lg:hidden"
		aria-label="Mobile"
	>
		<div class="flex flex-col gap-4">
			{
				links.map((link) =>
					link.accent ? (
						<a
							href={link.href}
							class="flex items-center gap-2 text-[18px] leading-normal text-[#e84949]"
							data-nav-link
						>
							<span class="relative h-[21.818px] w-6 shrink-0 overflow-hidden">
								<span class="absolute top-[4.28%] right-[35.34%] bottom-[31.07%] left-0">
									<img src="/images/gear-big.svg" alt="" width="15.5175" height="14.107" />
								</span>
								<span class="absolute top-[48.68%] right-0 bottom-[4.28%] left-[52.96%]">
									<img src="/images/gear-small.svg" alt="" width="11.2893" height="10.2631" />
								</span>
							</span>
							{link.label}
						</a>
					) : (
						<a
							href={link.href}
							class="text-[18px] leading-normal text-black"
							data-nav-link
						>
							{link.label}
						</a>
					),
				)
			}
			<button
				type="button"
				class="mt-2 self-start text-left text-[18px] leading-normal text-black"
				data-theme-toggle
			>
				Dark Mode
			</button>
		</div>
	</nav>
</header>

<script>
	const initNavbar = () => {
		const toggle = document.querySelector('[data-nav-toggle]');
		const menu = document.getElementById('mobile-nav');
		const links = document.querySelectorAll('[data-nav-link]');

		if (!(toggle instanceof HTMLButtonElement) || !menu) {
			return;
		}

		const setOpen = (open: boolean) => {
			menu.classList.toggle('hidden', !open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		};

		toggle.addEventListener('click', () => {
			setOpen(menu.classList.contains('hidden'));
		});

		links.forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});
	};

	const initThemeToggle = () => {
		const buttons = document.querySelectorAll('[data-theme-toggle]');

		const isDarkMode = () => {
			const storedTheme = window.localStorage.getItem('theme');
			if (storedTheme) {
				return storedTheme === 'dark';
			}
			return window.matchMedia('(prefers-color-scheme: dark)').matches;
		};

		/** @param {boolean} dark */
		const applyTheme = (dark: boolean) => {
			document.documentElement.classList.toggle('dark', dark);
			document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
			window.localStorage.setItem('theme', dark ? 'dark' : 'light');

			buttons.forEach((button) => {
				button.textContent = dark ? 'Light Mode' : 'Dark Mode';
			});
		};

		const toggleDarkMode = () => {
			applyTheme(!isDarkMode());
		};

		applyTheme(isDarkMode());
		buttons.forEach((button) => {
			button.addEventListener('click', toggleDarkMode);
		});
	};

	document.addEventListener('astro:page-load', () => {
		initNavbar();
		initThemeToggle();
	});
	initNavbar();
	initThemeToggle();
</script>
