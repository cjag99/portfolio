---
import ImageSkeleton from './ImageSkeleton.astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<section
	class:list={['w-full bg-[#fcfcfc] font-be-vietnam px-8 py-6 min-[1440px]:px-[100px] min-[1440px]:py-[32px]', className]}
>
	<div class="flex flex-col items-center gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-10 min-[1440px]:gap-[281px]">
		<div class="order-2 flex w-full max-w-[298px] flex-col items-start gap-3 lg:order-1 lg:max-w-[553px] min-[1440px]:shrink-0 lg:gap-[30px]">
			<h1 class="font-semibold tracking-[0.18px] text-[#343d68]">
				<span class="block text-[22px] leading-[1.176] lg:text-[32px]">Hi👋, I’m a</span>
				<span class="block text-[28px] leading-[1.176] capitalize lg:text-[48px]">Software Developer</span>
			</h1>
			<p class="text-[18px] leading-[1.576] text-black/70 lg:max-w-[553px] lg:leading-normal">
				I’m <span class="font-bold">John Doe</span>, a developer dedicated to making the world a better
				place one line of code at a time.
			</p>
			<a
				href="#contact"
				class="rounded bg-[#e84949] px-6 py-2.5 text-center text-[18px] leading-normal text-white shadow-[0_1px_5px_rgba(0,0,0,0.2),0_3px_1px_rgba(0,0,0,0.12),0_2px_2px_rgba(0,0,0,0.14)] lg:px-4 lg:py-2"
			>
				Hire me
			</a>
		</div>

		<div class="relative order-1 h-[312px] w-[266px] shrink-0 lg:order-2 lg:h-[495px] lg:w-[411px]">
			<ImageSkeleton
				label="Portrait image should go here"
				class="absolute top-[34.74px] left-[41px] h-[238px] w-[204px] lg:top-[53.37px] lg:left-[43.45px] lg:h-[389.111px] lg:w-[343.85px]"
			/>

			<ImageSkeleton
				label="Zigzag decoration should go here"
				compact
				class="absolute top-[22.45px] left-0 h-[60px] w-[22px] lg:hidden"
			/>
			<ImageSkeleton
				label="Zigzag decoration should go here"
				compact
				class="absolute top-[33.78px] left-0 hidden h-[99px] w-[38px] lg:flex"
			/>

			<ImageSkeleton
				label="Cube decoration should go here"
				compact
				class="absolute top-[1.75px] left-[232.91px] h-[25px] w-[24px] lg:hidden"
			/>
			<ImageSkeleton
				label="Cube decoration should go here"
				compact
				class="absolute top-0 left-[370.47px] hidden h-[40.532px] w-[40.532px] lg:flex"
			/>

			<ImageSkeleton
				label="Plus decoration should go here"
				compact
				class="absolute top-0 left-[103.94px] h-[20px] w-[19px] lg:hidden"
			/>
			<ImageSkeleton
				label="Plus decoration should go here"
				compact
				class="absolute top-0 left-[164.43px] hidden h-[27px] w-[26px] lg:flex"
			/>

			<ImageSkeleton
				label="Circle decoration should go here"
				compact
				class="absolute top-[281.75px] left-[22px] h-[13px] w-[14px] lg:hidden"
			/>
			<ImageSkeleton
				label="Circle decoration should go here"
				compact
				class="absolute top-[456.67px] left-[22.56px] hidden h-[21.617px] w-[21.617px] lg:flex"
			/>

			<ImageSkeleton
				label="Dots"
				class="absolute top-[251.75px] left-[161px] h-[60px] w-[105px] lg:hidden"
			/>
			<ImageSkeleton
				label="Dots"
				class="absolute top-[419px] left-[288px] hidden h-[76px] w-[120px] lg:flex"
			/>
		</div>
	</div>
</section>
