---
import ImageSkeleton from './ImageSkeleton.astro';
import { useTranslations } from '../i18n/ui';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const { t, interpolate } = useTranslations(Astro.currentLocale);
const greeting = interpolate(t('greeting'), { name: t('name') });
---

<section
	class:list={['w-full bg-[#fcfcfc] font-be-vietnam px-8 py-6 min-[1440px]:px-[100px] min-[1440px]:py-[32px] dark:bg-black', className]}
>
	<div class="flex flex-col items-center gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-10 min-[1440px]:gap-[281px]">
		<div class="order-2 flex w-full max-w-[298px] flex-col items-start gap-3 lg:order-1 lg:max-w-[553px] min-[1440px]:shrink-0 lg:gap-[30px]">
			<h1 class="font-semibold tracking-[0.18px] text-[#343d68] dark:text-white">
				<span class="block text-[22px] leading-[1.176] lg:text-[32px]">{greeting}</span>
				<span class="block text-[28px] leading-[1.176] capitalize lg:text-[48px]">Software Developer</span>
			</h1>
			<p class="text-[18px] leading-[1.576] text-black/70 lg:max-w-[553px] lg:leading-normal dark:text-white/70">
				{t('description')}
			</p>
			<a
				download="#"
				href="#contact"
				class="rounded bg-[#e84949] px-6 py-2.5 text-center text-[18px] leading-normal text-white shadow-[0_1px_5px_rgba(0,0,0,0.2),0_3px_1px_rgba(0,0,0,0.12),0_2px_2px_rgba(0,0,0,0.14)] lg:px-4 lg:py-2"
			>
				Hire me
			</a>
		</div>
	</div>
</section>
