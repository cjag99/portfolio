---
import { Icon } from 'astro-icon/components';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const links = [
	{ href: '/', label: 'Home', icon: 'lucide:house' },
	{ href: '#skills', label: 'Skills', icon: 'lucide:code' },
	{ href: '#studies', label: 'Studies', icon: 'lucide:graduation-cap' },
	{ href: '#projects', label: 'Projects', icon: 'lucide:briefcase' },
	{ href: '#contact', label: 'Contact me', icon: 'lucide:mail', center: true },
] as const;

const centerSlot = Math.ceil(links.length / 2);
let nextOrder = 1;
const items = links.map((link) => {
	const isCenter = 'center' in link && link.center === true;
	let order = centerSlot;
	if (!isCenter) {
		if (nextOrder === centerSlot) nextOrder += 1;
		order = nextOrder;
		nextOrder += 1;
	}
	return { ...link, isCenter, order };
});
---

<nav
	class:list={[
		'fixed inset-x-0 bottom-0 z-50 border-t border-black/10 bg-[#fcfcfc] font-be-vietnam pb-[env(safe-area-inset-bottom)]',
		className,
	]}
	aria-label="Mobile"
>
	<div class="flex items-end justify-around px-2 pt-2 pb-3">
		{
			items.map((item) => (
				<a
					href={item.href}
					class:list={[
						'flex min-w-0 flex-1 flex-col items-center gap-1 text-center',
						item.isCenter
							? `-mt-3 order-3 text-[#e84949]`
							: `text-black order-${item.order}`,
					]}
					style={`order: ${item.order}`}
				>
					<Icon
						name={item.icon}
						size={item.isCenter ? 32 : 24}
						class="shrink-0"
						aria-hidden="true"
					/>
					<span class="max-w-full truncate text-[10px] leading-tight">{item.label}</span>
				</a>
			))
		}
	</div>
</nav>
