---
import { Icon } from 'astro-icon/components';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<section
	id="skills"
	class:list={[
		'w-full bg-[#fcfcfc] font-be-vietnam px-8 py-8 min-[1440px]:px-[100px] min-[1440px]:py-[32px] dark:bg-black',
		className,
	]}
>
	<div class="flex flex-col gap-8 lg:flex-row lg:gap-10">
		<div class="flex-1 rounded-lg border border-black/10 p-6 dark:border-white/10">
			Frontend
			<div class="flex flex-wrap gap-2">
				<div class="grid grid-cols-5 gap-8 items-center justify-center text-center text-2xl font-bold">
					<div class="flex flex-col items-center justify-center">
					<Icon name="devicon:html5" class="text-8xl text-center" />	
					<span>HTML</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:css3" class="text-8xl text-center" />	
						<span>CSS</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:javascript" class="text-8xl text-center" />
						<span>JavaScript</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:typescript" class="text-8xl text-center" />
						<span>TypeScript</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:nodejs" class="text-8xl text-center" />
						<span>Node.js</span>
					</div>
				</div>
				<div class="grid grid-cols-5 gap-8 items-center justify-center text-center text-2xl font-bold">
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:react" class="text-8xl text-center" />
						<span>React</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:nextjs" class="text-8xl text-center" />
						<span>Next.js</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:vuejs" class="text-8xl text-center" />
						<span>Vue.js</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:tailwindcss" class="text-8xl text-center" />
						<span>Tailwind CSS</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:bootstrap" class="text-8xl text-center" />
						<span>Bootstrap</span>
					</div>
				</div>
			</div>
		</div>
		<div class="flex-1 rounded-lg border border-black/10 p-6 dark:border-white/10">
			Backend
			<div class="flex flex-wrap gap-2">
				<div class="grid grid-cols-4 gap-8 items-center justify-center text-center text-2xl font-bold">
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:java" class="text-8xl text-center" />
						<span>Java</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:php" class="text-8xl text-center" />
						<span>PHP</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:laravel" class="text-8xl text-center" />
						<span>Laravel</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:python" class="text-8xl text-center" />
						<span>Python</span>
					</div>
				</div>
				<div class="grid grid-cols-3 gap-8 items-center justify-center text-center text-2xl font-bold">
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:djangorest" class="text-8xl text-center" />
						<span>Django</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:fastapi" class="text-8xl text-center" />
						<span>FastAPI</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:flask" class="text-8xl text-center" />
						<span>Flask</span>
					</div>
				</div>
			</div>
		</div>
		<div class="flex-1 rounded-lg border border-black/10 p-6 dark:border-white/10">
			Herramientas &amp; Devops
			<div class="flex flex-wrap gap-2">
				<div class="grid grid-cols-5 gap-8 items-center justify-center text-center text-2xl font-bold">
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:vitejs" class="text-8xl text-center" />
						<span>Vite</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="simple-icons:jest" class="text-8xl text-center" />
						<span>Jest</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:junit" class="text-8xl text-center" />
						<span>JUnit</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:pytest" class="text-8xl text-center" />
						<span>Pytest</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:git" class="text-8xl text-center" />
						<span>Git</span>
					</div>
				</div>
				<div class="grid grid-cols-5 gap-8 items-center justify-center text-center text-2xl font-bold">
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:docker" class="text-8xl text-center" />
						<span>Docker</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:mysql" class="text-8xl text-center" />
						<span>MySQL</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:postgresql" class="text-8xl text-center" />
						<span>PostgreSQL</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:supabase" class="text-8xl text-center" />
						<span>Supabase</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:amazonwebservices" class="text-8xl text-center" />
						<span>AWS</span>
					</div>
				</div>
				<div class="grid grid-cols-2 gap-8 items-center justify-center text-center text-2xl font-bold">
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:cursor" class="text-8xl text-center" />
						<span>Cursor</span>
					</div>
					<div class="flex flex-col items-center justify-center">
						<Icon name="devicon:claudecode" class="text-8xl text-center" />
						<span>Claude Code</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
