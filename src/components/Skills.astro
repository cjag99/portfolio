---
import ImageSkeleton from './ImageSkeleton.astro';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const skills = [
	{ name: 'HTML 5', icon: 'HTML 5 icon should go here', class: 'order-3 lg:order-1' },
	{ name: 'CSS3', icon: 'CSS3 icon should go here', class: 'order-1 lg:order-2' },
	{ name: 'JavaScript', icon: 'JavaScript icon should go here', class: 'order-2 lg:order-3' },
	{ name: 'Bootstrap', icon: 'Bootstrap icon should go here', class: 'order-4' },
] as const;
---

<section
	id="skills"
	class:list={[
		'w-full bg-[#fcfcfc] font-be-vietnam px-8 py-8 min-[1440px]:px-[100px] min-[1440px]:py-[32px]',
		className,
	]}
>
	<div class="flex flex-col items-center gap-[30px]">
		<h2 class="text-[25px] leading-normal font-semibold text-[#e84949] lg:text-[20px] lg:font-medium">
			Skills
		</h2>

		<div class="flex w-full flex-col items-center gap-10 lg:flex-row lg:items-center lg:justify-between">
			<ImageSkeleton
				label="Skills illustration should go here"
				class="h-[186px] w-[250px] shrink-0 lg:order-2 lg:h-[414px] lg:w-[511px]"
			/>

			<div class="flex w-full max-w-[518px] flex-col items-center gap-6 lg:order-1 lg:items-start lg:gap-10">
				<p class="max-w-[293px] text-center text-[18px] leading-normal text-[#818080] lg:max-w-none lg:text-left lg:whitespace-nowrap">
					I have a vast experience in the following web technologies:
				</p>

				<div class="grid w-full grid-cols-2 justify-items-center gap-x-8 gap-y-8 lg:flex lg:w-auto lg:items-start lg:gap-[42px]">
					{
						skills.map((skill) => (
							<div class:list={['flex flex-col items-center gap-1', skill.class]}>
								<ImageSkeleton
									label={skill.icon}
									class="size-[118px] lg:size-[75px]"
								/>
								<p class="text-center text-[18px] leading-[29px] text-black lg:text-[16px]">
									{skill.name}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
