---
import { Icon } from 'astro-icon/components';

interface Props {
	class?: string;
}

interface Skill {
	name: string;
	icon: string;
}

const { class: className } = Astro.props;

const frontend: Skill[] = [
	{ name: 'HTML', icon: 'devicon:html5' },
	{ name: 'CSS', icon: 'devicon:css3' },
	{ name: 'JavaScript', icon: 'devicon:javascript' },
	{ name: 'TypeScript', icon: 'devicon:typescript' },
	{ name: 'Node.js', icon: 'devicon:nodejs' },
	{ name: 'React', icon: 'devicon:react' },
	{ name: 'Next.js', icon: 'devicon:nextjs' },
	{ name: 'Vue.js', icon: 'devicon:vuejs' },
	{ name: 'Tailwind CSS', icon: 'devicon:tailwindcss' },
	{ name: 'Bootstrap', icon: 'devicon:bootstrap' },
];

const backend: Skill[] = [
	{ name: 'Java', icon: 'devicon:java' },
	{ name: 'PHP', icon: 'devicon:php' },
	{ name: 'Laravel', icon: 'devicon:laravel' },
	{ name: 'Python', icon: 'devicon:python' },
	{ name: 'Django', icon: 'devicon:djangorest' },
	{ name: 'FastAPI', icon: 'devicon:fastapi' },
	{ name: 'Flask', icon: 'devicon:flask' },
];

const tools: Skill[] = [
	{ name: 'Vite', icon: 'devicon:vitejs' },
	{ name: 'Jest', icon: 'simple-icons:jest' },
	{ name: 'JUnit', icon: 'devicon:junit' },
	{ name: 'Pytest', icon: 'devicon:pytest' },
	{ name: 'Git', icon: 'devicon:git' },
	{ name: 'Docker', icon: 'devicon:docker' },
	{ name: 'MySQL', icon: 'devicon:mysql' },
	{ name: 'PostgreSQL', icon: 'devicon:postgresql' },
	{ name: 'Supabase', icon: 'devicon:supabase' },
	{ name: 'AWS', icon: 'devicon:amazonwebservices' },
	{ name: 'Cursor', icon: 'devicon:cursor' },
	{ name: 'Claude Code', icon: 'devicon:claudecode' },
];

const groups = [
	{ title: 'Frontend', skills: frontend },
	{ title: 'Backend', skills: backend },
	{ title: 'Herramientas & Devops', skills: tools },
];
---

<section
	id="skills"
	class:list={[
		'w-full font-be-vietnam px-4 py-8 sm:px-8 min-[1440px]:px-[100px] min-[1440px]:py-[32px]',
		className,
	]}
>
	<div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
		{
			groups.map((group) => (
				<article class="group min-w-0 transition-[filter] hover:drop-shadow-[0_0_12px_var(--color-hover)]">
					<div class="cyber-cut bg-border p-1 transition-colors group-hover:bg-hover">
						<div class="cyber-ticks h-full p-4 sm:p-6">
							<h3 class="mb-4 flex items-center gap-2.5 border-b border-border pb-2 text-[0.8rem] font-semibold tracking-[0.22em] text-hover uppercase">
								<span
									class="size-[0.55rem] shrink-0 bg-hover shadow-[0_0_8px_var(--color-hover)] [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)]"
									aria-hidden="true"
								></span>
								{group.title}
							</h3>
							<div class="grid grid-cols-2 justify-items-center gap-x-3 gap-y-5 min-[400px]:grid-cols-3 sm:gap-x-4 sm:gap-y-6">
								{group.skills.map((skill) => (
									<div class="flex w-full min-w-0 flex-col items-center gap-1.5 text-center">
										<Icon name={skill.icon} class="size-10 shrink-0 sm:size-12" />
										<span class="w-full text-xs font-semibold leading-tight break-words text-border transition-colors group-hover:text-hover sm:text-sm">
											{skill.name}
										</span>
									</div>
								))}
							</div>
						</div>
					</div>
				</article>
			))
		}
	</div>
</section>
