---
import { useTranslations } from '../i18n/ui';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
const { t } = useTranslations(Astro.currentLocale);
const paragraphs = t('aboutmeDescription').split(/\n\n+/);
---

<section
	id="about"
	class:list={[
		'w-full font-be-vietnam px-4 py-8 sm:px-8 min-[1440px]:px-[100px] min-[1440px]:py-[32px]',
		className,
	]}
>
	<article class="group mx-auto min-w-0 w-full max-w-4xl transition-[filter] hover:drop-shadow-[0_0_12px_var(--color-hover)]">
		<div class="cyber-cut bg-border p-1 transition-colors group-hover:bg-hover">
			<div class="cyber-ticks p-4 sm:p-6 md:p-8">
				<h2 class="mb-4 flex items-center gap-2.5 border-b border-border pb-2 text-[0.8rem] font-semibold tracking-[0.22em] text-hover uppercase">
					<span
						class="size-[0.55rem] shrink-0 bg-hover shadow-[0_0_8px_var(--color-hover)] [clip-path:polygon(50%_0,100%_50%,50%_100%,0_50%)]"
						aria-hidden="true"
					></span>
					{t('aboutme')}
				</h2>
				<div class="flex flex-col gap-4">
					{
						paragraphs.map((paragraph) => (
							<p class="text-sm leading-relaxed text-border transition-colors group-hover:text-hover sm:text-base">
								{paragraph}
							</p>
						))
					}
				</div>
			</div>
		</div>
	</article>
</section>
