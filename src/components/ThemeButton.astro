---
import { Icon } from 'astro-icon/components';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<button
	type="button"
	data-theme-toggle
	class:list={[
		'grid h-9 w-16 shrink-0 grid-cols-2 items-center overflow-visible px-1.5',
		'lg:h-10 lg:w-24 lg:px-2',
		className,
	]}
	aria-label="Toggle theme"
	aria-pressed="false"
>
	<span
		data-theme-icon="sun"
		class="relative z-0 col-start-1 inline-flex justify-self-start dark:opacity-0"
	>
		<Icon
			name="lucide:sun"
			class="size-5 text-[#ff7a18] filter-[drop-shadow(0_0_4px_#ffb347)_drop-shadow(0_0_12px_#ff6b00)] lg:size-6"
			aria-hidden="true"
		/>
	</span>
	<span
		data-theme-icon="moon"
		class="relative z-0 col-start-2 inline-flex justify-self-end opacity-0 dark:opacity-100"
	>
		<Icon
			name="lucide:moon"
			class="size-5 text-[#fde68a] filter-[drop-shadow(0_0_6px_#fef9c3)_drop-shadow(0_0_14px_#e8d48b)] lg:size-6"
			aria-hidden="true"
		/>
	</span>
</button>

<script>
	import { gsap } from 'gsap';

	function isDark() {
		return document.documentElement.classList.contains('dark');
	}

	function applyTheme(dark: boolean) {
		document.documentElement.classList.toggle('dark', dark);
		localStorage.setItem('theme', dark ? 'dark' : 'light');
	}

	function getIcons(button: HTMLButtonElement) {
		const sun = button.querySelector<HTMLElement>('[data-theme-icon="sun"]');
		const moon = button.querySelector<HTMLElement>('[data-theme-icon="moon"]');
		return { sun, moon };
	}

	function syncButton(button: HTMLButtonElement) {
		const dark = isDark();
		button.setAttribute('aria-pressed', String(dark));
		button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
	}

	function syncIcons(button: HTMLButtonElement) {
		const { sun, moon } = getIcons(button);
		if (!sun || !moon) return;
		gsap.killTweensOf([sun, moon]);
		const dark = isDark();
		gsap.set(sun, { autoAlpha: dark ? 0 : 1, x: 0, scale: 1, zIndex: 0 });
		gsap.set(moon, { autoAlpha: dark ? 1 : 0, x: 0, scale: 1, zIndex: 0 });
	}

	function syncAllToggles() {
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
			syncButton(button);
			syncIcons(button);
		});
	}

	function syncAllLabels() {
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(syncButton);
	}

	function prefersReducedMotion() {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function morphIcon(
		button: HTMLButtonElement,
		traveler: HTMLElement,
		inbound: HTMLElement,
		travelX: number,
		onComplete: () => void,
	) {
		gsap.killTweensOf([traveler, inbound]);
		button.dataset.themeAnimating = 'true';
		gsap.set(traveler, { autoAlpha: 1, x: 0, scale: 1, zIndex: 1, transformOrigin: 'center' });
		gsap.set(inbound, { autoAlpha: 0, x: 0, scale: 0.65, zIndex: 2, transformOrigin: 'center' });

		gsap
			.timeline({
				defaults: { duration: 0.32, ease: 'power2.inOut' },
				onComplete: () => {
					gsap.set([traveler, inbound], { zIndex: 0 });
					onComplete();
					delete button.dataset.themeAnimating;
				},
			})
			.to(traveler, { x: travelX })
			.to(traveler, { autoAlpha: 0, scale: 0.65, duration: 0.18 }, '-=0.14')
			.to(inbound, { autoAlpha: 1, scale: 1, duration: 0.18 }, '<');
	}

	function sunsetAnimation(button: HTMLButtonElement) {
		const { sun, moon } = getIcons(button);
		if (!sun || !moon) return;

		applyTheme(true);
		syncAllLabels();

		if (prefersReducedMotion()) {
			syncAllToggles();
			return;
		}

		const delta = moon.getBoundingClientRect().left - sun.getBoundingClientRect().left;
		morphIcon(button, sun, moon, delta, () => syncAllToggles());
	}

	function dawnAnimation(button: HTMLButtonElement) {
		const { sun, moon } = getIcons(button);
		if (!sun || !moon) return;

		if (prefersReducedMotion()) {
			applyTheme(false);
			syncAllToggles();
			return;
		}

		const delta = moon.getBoundingClientRect().left - sun.getBoundingClientRect().left;
		morphIcon(button, moon, sun, -delta, () => {
			applyTheme(false);
			syncAllToggles();
		});
	}

	function initThemeToggles() {
		document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
			syncButton(button);
			syncIcons(button);
			if (button.dataset.themeBound === 'true') return;
			button.dataset.themeBound = 'true';
			button.addEventListener('click', () => {
				if (button.dataset.themeAnimating === 'true') return;
				if (isDark()) {
					dawnAnimation(button);
				} else {
					sunsetAnimation(button);
				}
			});
		});
	}

	initThemeToggles();
	document.addEventListener('astro:page-load', initThemeToggles);
</script>
